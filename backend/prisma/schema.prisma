// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Estacionamiento {
  id             String   @id @default(uuid())
  nombre         String
  ubicacion_gps  String?

  // Estado cajón A
  ocupado_a      Boolean  @default(false)
  reservado_a    Boolean  @default(false)
  token_reserva_a String?

  // Estado cajón B
  ocupado_b      Boolean  @default(false)
  reservado_b    Boolean  @default(false)
  token_reserva_b String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("estacionamientos")
}
